APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.nexthitmarket.com
# Shared universal account and production catalog project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PRODUCTION_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_PRODUCTION_REPLACE_ME
# Isolated staging simulations and role assignments (server-only).
STAGING_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
STAGING_SUPABASE_SECRET_KEY=sb_secret_STAGING_REPLACE_ME
ENABLE_GAME_MASTER_CONSOLE=true
ENABLE_STAGING_ROLE_ADMIN=true
ROOT_ADMIN_EMAILS=owner@example.com
STAGING_ALLOWED_HOSTS=staging.nexthitmarket.com,admin.staging.nexthitmarket.com
# Local build verification only. Never set this in the remote deployment.
ALLOW_LOCAL_STAGING_BUILD=false
